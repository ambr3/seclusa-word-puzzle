# Netlify / Cloudflare Pages–style headers. GitHub Pages ignores this file.
# Keep in step with index.html CSP meta. frame-ancestors is header-only.
# SAMEORIGIN / frame-ancestors 'self' so the Seclusa Games launcher can embed.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; child-src 'none'; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
/index.html
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
